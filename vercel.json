{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/explicacao.js": {
      "maxDuration": 60,
      "includeFiles": "public/provas/**"
    },
    "api/concursos.js": {
      "includeFiles": "public/provas/**"
    },
    "api/stats.js": {
      "includeFiles": "public/provas/index.json"
    },
    "api/page.js": {
      "includeFiles": "{content/blog/**,lib/og-fonts/**,public/brand/logo-horizontal-escuro.svg}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "checknoconcurso.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/provas",
      "destination": "/api/concursos?tipo=provas"
    },
    {
      "source": "/api/ultimos-dias",
      "destination": "/api/concursos?tipo=ultimos"
    },
    {
      "source": "/api/progresso",
      "destination": "/api/concursos?tipo=progresso"
    },
    {
      "source": "/api/prova-previa/:id",
      "destination": "/api/concursos?tipo=previa&c=:id"
    },
    {
      "source": "/api/prova/:id",
      "destination": "/api/concursos?tipo=prova&c=:id"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/page?tipo=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/page?tipo=llms&completo=1"
    },
    {
      "source": "/og/:formato/:arquivo",
      "destination": "/api/page?tipo=og&formato=:formato&arquivo=:arquivo"
    },
    {
      "source": "/concurso/:id",
      "destination": "/api/page?tipo=concurso&id=:id"
    },
    {
      "source": "/concursos/:uf",
      "destination": "/api/page?tipo=estado&uf=:uf"
    },
    {
      "source": "/blog",
      "destination": "/api/page?tipo=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?tipo=blog&slug=:slug"
    },
    {
      "source": "/api/blog-recentes",
      "destination": "/api/page?tipo=blog-recentes"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?tipo=sitemap"
    },
    {
      "source": "/api/admin/:acao",
      "destination": "/api/admin?acao=:acao"
    },
    {
      "source": "/api/stripe/:acao",
      "destination": "/api/stripe?acao=:acao"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "buildCommand": "node tools/build-public.mjs"
}
